# Backend environment variables
DATABASE_URL=postgresql://sahifalab_user:your_password@localhost:5432/sahifalab_db
DATABASE_ECHO=False
DEBUG=True

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=sahifalab_hub_bot

# Admin
ADMIN_TELEGRAM_IDS=

# Payment — get provider tokens from @BotFather → Payments
CLICK_PROVIDER_TOKEN=
PAYME_PROVIDER_TOKEN=

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Security
ALLOWED_HOSTS=["localhost","127.0.0.1"]

BUNNY_STORAGE_ZONE=sahifalab
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=sahifalab.b-cdn.net
BUNNY_STORAGE_REGION=sg

# Google OAuth (backend verifies Google ID tokens against this client ID)
GOOGLE_CLIENT_ID=

# Gemini API (088/089 Tanga+AI) — get from aistudio.google.com, must be a
# Tier 1 (billing-enabled) key, never the free tier. Never commit a real
# value here — this file is a checked-in template, not a secret store; set
# the real key directly in Railway's Variables tab, or in a local, gitignored
# `.env` (see backend/app/core/config.py's env_file loading and the repo
# root .gitignore, which excludes `.env` but NOT `.env.example`).
GEMINI_API_KEY=

