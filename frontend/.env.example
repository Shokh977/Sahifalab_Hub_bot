# Environment variables for frontend
# Point VITE_API_URL at your Railway backend (no /api suffix — added by the code).
# Example: VITE_API_URL=https://sahifalab-backend.up.railway.app
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=SAHIFALAB
VITE_TELEGRAM_BOT_TOKEN=8677307773:AAEIOyNXAU3LEHymy5b7Wy3VMB8Yu8bzaNU

# Supabase Storage — for ambient sound file uploads from Admin panel
# Get these from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Telegram bot username (without @) — used for the web Login Widget on /login
VITE_BOT_USERNAME=Sahifalab_hub_bot

# Gemini AI (direct frontend calls — fast, no Vercel cold start)
VITE_GEMINI_API_KEY=

# Google Sign-In (same OAuth Web Client ID as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Google Analytics 4 Measurement ID
VITE_GA_ID=G-XXXXXXXXXX

# Optional: Telegram chat ID where the bot stores uploaded audio files.
# Can be a private group/channel ID where the bot is an admin.
# If not set, the admin's own Telegram ID is used as the chat
# (requires the admin to have opened the bot at least once with /start).
VITE_STORAGE_CHAT_ID=